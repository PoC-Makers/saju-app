{
    "compilerOptions": {
        "target": "ES2023",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src"]
}
