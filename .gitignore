# Dependencies
node_modules/

# Yarn Berry (node-modules linker): 핀 고정한 yarn 바이너리(releases)는 커밋, 나머지는 무시
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build outputs
dist/
.next/
out/
build/
.turbo/

# Env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test coverage
coverage/

# 개인 학습 기록 (learning-recap 산출물) — 개인화 문서라 추적 안 함
docs/recaps/

# 내부 참고자료 — 저장소가 public이라 팀 내부용 문서는 추적하지 않는다.
